{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "types": ["node"], "jsx": "react-jsx"
  },
  "include": ["src", "tests"]
}
